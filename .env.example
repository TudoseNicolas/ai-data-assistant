# Copy this file to .env and fill in what you use.

# --- Cloud AI: Google Gemini (key from https://aistudio.google.com)
GEMINI_API_KEY=your-key-here
# Optional: another Gemini model, and fallbacks to try when it is busy (comma-separated)
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODELS=

# --- Local AI: Ollama (https://ollama.com), runs on your computer, no key needed
# AI_PROVIDER=ollama              # start the app with the local engine selected
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_HOST=http://localhost:11434
